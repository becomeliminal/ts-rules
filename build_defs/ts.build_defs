"""TypeScript for Please.

ts_library is a peer of js_library, not a client of it: it emits the same
<name>/pkg + <name>/lib.json shape, so a js_binary consumes it with no change to
js-rules. Declarations sit beside the JavaScript inside pkg/, which is what a
published npm package looks like and what a downstream type-check reads.

The compiler runs from its own node_modules tree, separate from the one holding
the code being compiled. That is not incidental: TypeScript 7 has no stable
programmatic API until 7.1, so typescript-eslint and the Vue, Svelte and Astro
checkers still need a 5.x, and one tree cannot hold two packages claiming the
name "typescript". Keeping the compiler's tree separate means this plugin pins
its own version without that pin reaching into a consumer's lockfile.

Both trees resolve correctly because of how the store is laid out: a package's
dependencies are siblings inside its own store entry, so node resolving from the
compiler's own path finds its native binary without ever walking up to the
consumer's tree, while the consumer's imports resolve upward from the staged
sources. The two walks cannot see each other.
"""

# CONFIG.JS is scoped to files that have loaded the js plugin, and these rules
# defer to its node toolchain, companion tool and node_modules tree rather than
# redeclaring them.
subinclude("///js//build_defs:js")


def ts_library(name:str, srcs:list, deps:list=[], assets:list=[], package:str="",
               entry:str="index.ts", root:str="", tsconfig:str="tsconfig.json",
               tsconfig_deps:list=[],
               module_type:str="", compiler:str="", transpiler:str="",
               node_modules:str="", type_roots:list=[],
               source_map:bool=False, declaration_map:bool=False,
               generate_trace:bool=False,
               args:list=[], visibility:list=None,
               test_only:bool&testonly=False, labels:list=[]):
    """A first-party TypeScript library.

    Args:
        name: Target name.
        srcs: Sources for the compiler -- .ts, .tsx and .d.ts, and .js and .jsx
              where the tsconfig sets allowJs.

            A repo does not have to be TypeScript to use this. With allowJs the
            compiler takes JavaScript too, emits declarations for it from its
            JSDoc, and with checkJs type-checks it -- so a repo with five
            hundred .js files and three .ts files points one rule at all of it,
            and one with no TypeScript at all still gets declarations and
            checking.

            There is deliberately no allow_js argument, though rules_ts has one.
            Theirs exists because Bazel has to predict which files are emitted
            before running the compiler, and allowJs changes that set. This rule
            emits a directory, so there is nothing to predict and nothing to
            keep in step with the tsconfig -- one fewer place for the two to
            disagree.
        deps: Other ts_library or js_library targets, and npm_repo targets.
        assets: Files copied into the package verbatim and never shown to the
                compiler. tsc does not copy a .css a component imports, but the
                placed package still needs it there.
        package: The name source code imports this by. Defaults to the package
                 path, as a Go import path mirrors its directory.
        entry: The source the package resolves to. index.ts gives main
               index.js and types index.d.ts.
        root: The prefix stripped from sources, and the compiler's --rootDir.
              Defaults to the package directory.

              Passed explicitly rather than inferred, and that matters: given
              only an output directory the compiler derives the root from the
              common prefix of its inputs, so adding one file at the top of a
              package would shift every emitted path -- and therefore every
              import path in node_modules. It would work for months and then
              break when someone added a file.
        tsconfig: The project's tsconfig -- a file, or a ts_config target,
                  which carries its own extends chain and makes tsconfig_deps
                  unnecessary.
        tsconfig_deps: The configs it extends, directly or transitively.

                       Listed rather than discovered: `extends` is resolved by
                       the compiler relative to the config naming it, and Please
                       stages sources at their real paths, so naming the chain
                       is all it takes -- nothing is parsed and no path is
                       rewritten. A filegroup cannot do this, because two files
                       both called tsconfig.json would collide on basename.
        module_type: The package.json "type" field. Stated here rather than read
                     out of the tsconfig, so nothing in this plugin parses one.
        source_map: Emit a .js.map beside each emitted file, so a stack trace
                    from this library's output points at the TypeScript it was
                    written as.
        declaration_map: Emit a .d.ts.map beside each declaration. Without it,
                         go-to-definition from a consumer lands in the generated
                         declarations rather than the source -- the difference
                         between navigating a library and reading its ceiling.
        generate_trace: Write the compiler's own performance trace into
                        <name>/trace, beside the package rather than inside it:
                        diagnostics for chrome://tracing, not package content,
                        and only ever wanted at the moment a compile got slow.
        compiler: node_modules tree holding the compiler. Defaults to the
                  Compiler config.

            Naming it per target is how a repo runs two compilers at once, which
            is not an edge case: TypeScript 7 has no stable programmatic API
            until 7.1, so typescript-eslint, ts-jest, ts-morph and the Vue,
            Svelte and Astro checkers all still need a 5.x -- and one
            node_modules cannot hold two packages both called typescript.
            //test/tsc5 compiles and checks against a 5.9 to prove it.
        transpiler: What writes the JavaScript. Defaults to the Transpiler
                    config, which defaults to "tsc": the compiler writes it.

            "esbuild" and "swc" are the transpilers this plugin ships, and a
            label names a ts_transpiler target. With any of them the compiler
            still type-checks every source and writes its declarations, here in
            this action, and only the JavaScript changes hands -- so a library
            that builds is a library that type-checks, whoever emitted it.

            The reason to hand it over is what gets written. The compiler
            emits an enum as a function call a bundler cannot prove harmless,
            so every enum in a module an application imports stays in its
            bundle; esbuild and swc mark the call as free of side effects.
            It is not speed: the type-check is the cost either way.

            A transpiler reads one file at a time, so the tsconfig must set
            isolatedModules, target and module, and the build fails -- naming
            the option -- if it sets anything that changes emitted JavaScript
            and the transpiler does not implement, rather than emitting
            something else. //test/emit holds all four emitters to the same
            behaviour.
        node_modules: The tree the sources resolve their imports through.
                      Defaults to js-rules' NodeModules config.
        type_roots: node_modules trees whose @types packages the compiler
                    loads, as --typeRoots and --types, beside the sources'
                    own tree rather than merged into it. What a ts_test suite
                    compiles against, so node:test resolves without the
                    consumer installing @types/node. Given on the command
                    line, these replace any types or typeRoots the tsconfig
                    sets.
        args: Additional compiler flags. The flags this rule's output contract
              depends on -- outDir, rootDir, declaration, noEmit and
              tsBuildInfoFile -- are set here and cannot be overridden.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    package = package or package_name()
    # Same constraint as js_library: the emitted package is imported by name,
    # and node's rules for a name are narrower than a path.
    check_package_name(package, name)
    root = root or package_name()
    compiler = compiler or CONFIG.TS.COMPILER
    node_modules = node_modules or CONFIG.JS.NODE_MODULES
    transpiler = _transpiler("ts_library", name, transpiler)

    # The sources a development server links in place of the compiled package,
    # laid out as the package is: relative to root, which the compiler strips,
    # so src/palette.ts is served at <package>/palette.ts exactly where
    # palette.js is emitted. Relative to the package directory instead, a
    # rooted library's every subpath import missed in development.
    pkg_dir = package_name()
    dev_root = (root + "/") if root else ""
    dev_srcs = []
    for f in srcs + assets:
        if f.startswith(":") or f.startswith("//"):
            dev_srcs += [f]
            continue
        full = f if f.startswith(pkg_dir + "/") else (f"{pkg_dir}/{f}" if pkg_dir else f)
        if not full.startswith(dev_root):
            fail(f"ts_library {name}: {f} is outside root ({root}), so it has no place in the package")
        dev_srcs += [full[len(dev_root):]]

    main = entry.replace(".tsx", ".js").replace(".ts", ".js")
    types = entry.replace(".tsx", ".d.ts").replace(".ts", ".d.ts")
    strip = (root + "/") if root else ""

    # A scratch directory at the staging root, so no `include` glob rooted at
    # A dep narrowed to one named output (":lib|types") cannot travel as a
    # dep -- deps stage every output regardless -- so it rides the srcs channel
    # instead, which is where the narrowing is honoured.
    narrowed = [d for d in deps if "|" in d]
    deps = [d for d in deps if "|" not in d]

    # A ts_config target carries its extends chain in its deps, and transitive
    # staging follows the deps channel, not a source's own deps -- so a label
    # tsconfig rides both: srcs names the file for -p, deps drags the chain.
    if tsconfig.startswith(":") or tsconfig.startswith("//"):
        deps += [tsconfig]

    # the package can reach the compiler's own output.
    out_dir = "_ts_out"

    set_flags = f"--set type={module_type}" if module_type else ""

    return build_rule(
        name = name,
        srcs = {
            "srcs": srcs,
            "assets": assets,
            "libs": narrowed,
            "config": [tsconfig],
            "extends": tsconfig_deps,
            "modules": [node_modules] if node_modules else [],
            "compiler": [compiler],
            "typeroots": type_roots,
            "transpiler": [transpiler] if transpiler else [],
        },
        # The same two named outputs js_library emits, for the same measured
        # reason: Please invalidates per output, so a bundle narrowed to
        # :lib|pkg stops rebuilding when a declaration changes and a ts_check
        # narrowed to :lib|types stops re-running when runtime code does. A
        # plain dep stages both and behaves as before.
        outs = {
            "pkg": [name],
            "types": [name + "_types"],
        },
        cmd = " && ".join([
            'PLEASE_JS=$(readlink -f "$TOOLS_PLEASE_JS")',
            'NODE=$(readlink -f "$TOOLS_NODE")',

            # The compiler's tree and the sources' tree, kept apart.
            'mkdir -p _compiler',
            'cp -R "$SRCS_COMPILER/." _compiler/',
            # Every first-party library staged here describes itself, so the set
            # is collected by shape. node_modules is pruned: without it the walk
            # covers the whole dependency tree twice.
            'LIBS=$(find . -name node_modules -prune -o -name lib.json -print | ' +
            'while read m; do printf -- "--lib %s:%s " "$m" "$(dirname "$m")/pkg"; done)',
            # A repo whose first-party code has no third-party dependencies has
            # no consumer tree at all, and the overlay makes an empty one.
            '"$PLEASE_JS" overlay --tree "${SRCS_MODULES:-}" --out node_modules $LIBS',

            # Run from the staging root: node_modules is then an ancestor of the
            # sources, which is what the compiler's upward resolution needs, and
            # diagnostics come out as pkg/file.ts(3,14) -- the repo path, which
            # an editor can open -- rather than a bare filename.
            f'BIN=$(readlink -f "$("$PLEASE_JS" resolve-bin --tree _compiler --package {CONFIG.TS.COMPILER_PACKAGE} --bin {CONFIG.TS.COMPILER_BIN})")',
            # The config is validated against the flags mirrored over it before
            # anything compiles. --rootDir below wins over whatever the config
            # says, so a rootDir in the chain that disagrees would be silently
            # ignored -- and the wrong emitted path is import paths inside
            # node_modules, which is much worse than the error this raises.
            #
            # Resolved with the rule's own compiler flags applied, so it is the
            # configuration the compiler runs under -- which a transpiler, when
            # there is one, is handed as the statement of what to emit.
            " ".join(['"$NODE" "$BIN" -p "$SRCS_CONFIG"'] + args + ["--showConfig > _showconfig.json"]),
        ] + ([
            # Every package under each tree's @types, named for --types, which
            # otherwise defaults to nothing in a tsconfig that sets types: [].
            'TYPE_ROOTS="" && TYPE_NAMES=""',
            'for t in $SRCS_TYPEROOTS; do TYPE_ROOTS="$TYPE_ROOTS${TYPE_ROOTS:+,}$t/@types"; ' +
            'for n in $(ls "$t/@types"); do TYPE_NAMES="$TYPE_NAMES${TYPE_NAMES:+,}$n"; done; done',
        ] if type_roots else []) + [
            f'"$PLEASE_JS" tsconfig-check --show-config _showconfig.json --config "$SRCS_CONFIG" --root "{root}"',
            " ".join([
                '"$NODE" "$BIN" -p "$SRCS_CONFIG"',
                f"--rootDir {root} --outDir {out_dir}",
                # With a transpiler the compiler checks every source and writes
                # the declarations, and leaves the JavaScript to it.
                "--declaration --noEmit false --emitDeclarationOnly " + ("true" if transpiler else "false"),
                "--tsBuildInfoFile _tsbuildinfo",
            ] + (['--typeRoots "$TYPE_ROOTS" --types "$TYPE_NAMES"'] if type_roots else [])
              + (["--sourceMap"] if source_map and not transpiler else [])
              + (["--declarationMap"] if declaration_map else [])
              + (["--generateTrace _trace"] if generate_trace else [])
              + args),
        ] + ([
            # After the compiler, into the same directory: the driver refuses
            # to write JavaScript for a source the compiler emitted no
            # declaration for, since that source was never type-checked.
            " ".join([
                '"$NODE" "$SRCS_TRANSPILER/driver.mjs"',
                f"--config _showconfig.json --root '{root}' --out {out_dir}",
            ] + ([f"--module-type {module_type}"] if module_type else [])
              + (["--source-map"] if source_map else [])
              + ["-- $SRCS_SRCS"]),
        ] if transpiler else []) + [

            # Assemble the shape js_library produces, so a js_binary consumes it
            # without knowing TypeScript was involved. tsc emits .js and .d.ts
            # into one directory; they part company here, declarations into a
            # package-shaped twin, for the same measured reason js_library
            # splits: Please invalidates per output.
            'mkdir -p "$OUTS_PKG/pkg" "$OUTS_TYPES/pkg"',
            f'cp -R {out_dir}/. "$OUTS_PKG/pkg/"',
            'TYPES_ABS="$TMP_DIR/$OUTS_TYPES"',
            'cd "$OUTS_PKG/pkg" && find . -name "*.d.ts" -o -name "*.d.ts.map" | while read f; do ' +
            'mkdir -p "$TYPES_ABS/pkg/$(dirname "$f")" && mv "$f" "$TYPES_ABS/pkg/$f"; done',
            'cd "$TMP_DIR"',
        ] + ([
            'cp -R _trace "$OUTS_PKG/trace"',
        ] if generate_trace else []) + [
            f'for a in ${SRCS_ASSETS:-}; do mkdir -p "$OUTS_PKG/pkg/$(dirname "${{a#{strip}}}")" && cp "$a" "$OUTS_PKG/pkg/${{a#{strip}}}"; done',
            " ".join([
                '"$PLEASE_JS" describe',
                f"--name {name} --package {package} --version 0.0.0",
                f"--main {main}",
                # Where the sources live, for a development server that serves
                # them instead of this compiled output -- it transforms the
                # TypeScript itself, which is why the entry is recorded as
                # written rather than as emitted. Assets are included because a
                # stylesheet a component imports must be servable too.
                f"--src-dir {root} --src-entry {entry}",
                " ".join([f"--src {f}" for f in dev_srcs]),
                set_flags,
                '--dir "$OUTS_PKG/pkg" --out "$OUTS_PKG/lib.json"',
            ]),
            # The twin: a compiler resolves the package by this manifest and
            # reads the declarations beside it; node never loads it.
            " ".join([
                '"$PLEASE_JS" describe',
                f"--name {name}_types --package {package} --version 0.0.0",
                f"--main {main} --types {types} --role types",
                set_flags,
                '--dir "$OUTS_TYPES/pkg" --out "$OUTS_TYPES/lib.json"',
            ]),
        ]),
        tools = {
            "please_js": [CONFIG.JS.PLEASE_JS_TOOL],
            "node": [CONFIG.JS.NODE_TOOL],
        },
        deps = deps,
        exported_deps = deps,
        needs_transitive_deps = True,
        visibility = visibility,
        test_only = test_only,
        # Bare labels for discovery -- plz query --include matches exactly --
        # beside the packaged ones that carry the data. js_library's label,
        # because to every consumer, including js_project, that is what this is.
        labels = labels + ["js_library", f"js_library:{package}", f"ts_library:{package}"],
        building_description = "Compiling...",
    )


def ts_config(name:str, src:str="tsconfig.json", deps:list=[],
              visibility:list=None, test_only:bool&testonly=False):
    """A tsconfig as a target, carrying the chain it extends.

    This rule existed once and was deleted: as a filegroup collecting several
    configs it flattened them to basenames in its own package, and two
    tsconfig.json files collided. The deletion was right for that shape and
    wrong as a conclusion. One target per config, each keeping its file in its
    own package, collides with nothing -- and the chain rides deps, so a
    consumer stages every config at its real path, which is the only thing
    `extends` (resolved relative to the file naming it) ever needed.

    What this buys over tsconfig_deps: the base config is a target rather than
    a path every package repeats. A package's tsconfig names its ts_config
    target's deps once; consumers say tsconfig = ":tsconfig" and carry no
    knowledge of the chain, so adding a link to it changes one BUILD file
    rather than every rule that ever listed the chain by hand.

    Args:
        name: Target name.
        src: The config file itself.
        deps: ts_config targets for every config this one extends. Direct
              extends only -- each target names its own, and transitivity does
              the rest.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
    """
    return filegroup(
        name = name,
        srcs = [src],
        deps = deps,
        visibility = visibility,
        test_only = test_only,
        labels = ["ts_config"],
    )


def ts_transpiler(name:str, adapter:str, node_modules:str, visibility:list=None,
                  test_only:bool&testonly=False):
    """A transpiler a ts_library can hand its JavaScript to.

    The compiler is the only thing that reads types, so it always type-checks a
    library and writes its declarations. What writes the JavaScript is a
    separate choice, and this is how one is made available: name the target as
    a ts_library's `transpiler`, or as the Transpiler config for a whole repo.
    The plugin's own esbuild and swc are two of these (///ts//tools/transpile),
    built with nothing a repo's own could not use.

    A transpiler is an adapter and the tree holding the tool it adapts. The
    adapter is a JavaScript module the driver loads, exporting:

        name        what to call it in messages
        honours     the compiler options that change emitted JavaScript and
                    that it implements, by name
        transpile   async ({filename, source, format, options, sourceMap})
                    returning {code, map}
        close       optional, called once at the end

    format is "esm" or "cjs", decided per file by the driver; options are the
    resolved compiler options. Everything a transpiler would otherwise have to
    get right about a tsconfig is the driver's, the same for all of them: which
    format a file gets, which options matter, and failing the build when the
    tsconfig asks for one the adapter does not list in `honours`. An adapter
    is therefore about as long as the call to the tool it wraps.

    Args:
        name: Target name.
        adapter: The adapter module, a file in this package.
        node_modules: The tree holding the tool, from npm_link. Its own tree
                      rather than the sources', for the reason the compiler
                      has one: the tool's version is then pinned here and
                      reaches nobody's lockfile.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
    """
    return build_rule(
        name = name,
        srcs = {
            "adapter": [adapter],
            "driver": [CONFIG.TS.TRANSPILE_DRIVER],
            "tree": [node_modules],
        },
        # One directory: the driver, the adapter it loads, and the tree the
        # adapter's imports resolve through, beside one another the way any
        # node program and its node_modules are.
        outs = [name],
        cmd = " && ".join([
            'mkdir "$OUT"',
            'cp "$SRCS_DRIVER" "$OUT/driver.mjs"',
            'cp "$SRCS_ADAPTER" "$OUT/adapter.mjs"',
            'cp -R "$SRCS_TREE" "$OUT/node_modules"',
        ]),
        visibility = visibility,
        test_only = test_only,
        labels = ["ts_transpiler"],
        building_description = "Arranging...",
    )


def _transpiler(rule:str, name:str, transpiler:str):
    """The ts_transpiler target a rule's transpiler names, or "" for the compiler."""
    transpiler = transpiler or CONFIG.TS.TRANSPILER
    if transpiler == "tsc":
        return ""
    if transpiler == "esbuild":
        return CONFIG.TS.ESBUILD_TRANSPILER
    if transpiler == "swc":
        return CONFIG.TS.SWC_TRANSPILER
    if transpiler.startswith("//") or transpiler.startswith(":"):
        return transpiler
    fail(f"{rule} {name}: transpiler is \"tsc\", \"esbuild\", \"swc\" or the label of a " +
         f"ts_transpiler target, not \"{transpiler}\"")


def ts_check(name:str, srcs:list, deps:list=[], tsconfig:str="tsconfig.json",
             tsconfig_deps:list=[], compiler:str="", node_modules:str="",
             args:list=[], visibility:list=None, test_only:bool&testonly=False,
             labels:list=[]):
    """Type-checks sources without emitting anything.

    ts_library is the wrong shape for an application. An application is not
    imported by name, has no package to be, and its JavaScript is produced by a
    bundler rather than by the compiler -- so a rule that emits a package would
    be emitting something nobody consumes.

    But the checking still has to happen somewhere, and a bundler will not do
    it: esbuild, which is what vite transpiles with, strips types without
    reading them, so a type error in an application reaches production without
    ever failing a build. This is the target that fails it.

    Separate from the bundle on purpose, and not only because the shapes differ.
    They are different failures with different inputs: a type error is not a
    reason to invalidate a bundle's cache, and a changed asset is not a reason
    to type-check again. `tsc && vite build` is the same split, drawn by hand.

    Args:
        name: Target name.
        srcs: Sources to check.
        deps: ts_library and js_library targets the sources import, and npm_repo
              targets. A first-party dependency is checked against its generated
              declarations, which is the whole reason ts_library emits them.
        tsconfig: The tsconfig for this package.
        tsconfig_deps: Every config in the extends chain.
        compiler: node_modules tree holding the compiler. Defaults to the
                  Compiler config.
        node_modules: The tree the sources resolve their imports through.
        args: Additional compiler flags. --noEmit is set here and cannot be
              overridden, since it is the entire point.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    compiler = compiler or CONFIG.TS.COMPILER
    node_modules = node_modules or CONFIG.JS.NODE_MODULES

    # A dep narrowed to one named output (":lib|types") cannot travel as a
    # dep -- deps stage every output regardless -- so it rides the srcs channel
    # instead, which is where the narrowing is honoured.
    narrowed = [d for d in deps if "|" in d]
    deps = [d for d in deps if "|" not in d]

    # A ts_config target carries its extends chain in its deps, and transitive
    # staging follows the deps channel, not a source's own deps -- so a label
    # tsconfig rides both: srcs names the file for -p, deps drags the chain.
    if tsconfig.startswith(":") or tsconfig.startswith("//"):
        deps += [tsconfig]

    return build_rule(
        name = name,
        srcs = {
            "srcs": srcs,
            "libs": narrowed,
            "config": [tsconfig],
            "extends": tsconfig_deps,
            "modules": [node_modules] if node_modules else [],
            "compiler": [compiler],
        },
        # A stamp, because a rule with no output cannot be depended on and would
        # not run. It records what was checked rather than being empty, so a
        # failure to stage a source shows up as a missing name here.
        outs = [name + ".checked"],
        cmd = " && ".join([
            'PLEASE_JS=$(readlink -f "$TOOLS_PLEASE_JS")',
            'NODE=$(readlink -f "$TOOLS_NODE")',
            'mkdir -p _compiler',
            'cp -R "$SRCS_COMPILER/." _compiler/',
            'LIBS=$(find . -name node_modules -prune -o -name lib.json -print | ' +
            'while read m; do printf -- "--lib %s:%s " "$m" "$(dirname "$m")/pkg"; done)',
            '"$PLEASE_JS" overlay --tree "${SRCS_MODULES:-}" --out node_modules $LIBS',
            f'BIN=$(readlink -f "$("$PLEASE_JS" resolve-bin --tree _compiler --package {CONFIG.TS.COMPILER_PACKAGE} --bin {CONFIG.TS.COMPILER_BIN})")',
            " ".join([
                '"$NODE" "$BIN" -p "$SRCS_CONFIG" --noEmit',
                "--tsBuildInfoFile _tsbuildinfo",
            ] + args),
            'for s in $SRCS_SRCS; do echo "$s"; done > "$OUT"',
        ]),
        tools = {
            "please_js": [CONFIG.JS.PLEASE_JS_TOOL],
            "node": [CONFIG.JS.NODE_TOOL],
        },
        deps = deps,
        needs_transitive_deps = True,
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["ts_check"],
        building_description = "Type-checking...",
    )


def _ts_entry(name:str, lib:str, main:str, test_only:bool):
    """Generates the module that starts the program.

    The entry imports the library by its package name rather than by a path into
    the build output, so running a ts_binary exercises the resolution the
    library will actually get from its consumers. A path would work here and
    prove nothing.

    Always ESM, whatever the library emits. Node reads .mjs as a module
    regardless of any package.json, and an ESM entry can import a CommonJS
    package, so one shape serves both -- and neither this rule nor its caller
    has to know or restate the library's module type, which is the sort of
    duplicated declaration that goes stale silently.

    The package name is read out of lib.json with node rather than with sed: the
    file is JSON, node is already a tool here, and a real parser cannot be
    fooled by a package name containing a character that a pattern did not
    anticipate.
    """
    out = f"_{name}_entry.mjs"
    return build_rule(
        name = tag(name, "entry"),
        srcs = {"lib": [lib]},
        outs = [out],
        cmd = " && ".join([
            'NODE=$(readlink -f "$TOOLS_NODE")',
            'LIB=$(readlink -f "$(find $SRCS_LIB -name lib.json | head -1)")',
            '"$NODE" -e \'const p=require(process.argv[1]).package;' +
            'const s=process.argv[2];' +
            'process.stdout.write("import "+JSON.stringify(s?p+"/"+s:p)+";\\n")\' ' +
            f'"$LIB" "{main}" > "$OUT"',
        ]),
        tools = {"node": [CONFIG.JS.NODE_TOOL]},
        test_only = test_only,
        building_description = "Generating entry...",
    )


def ts_binary(name:str, lib:str, main:str="", deps:list=[], node_modules:str="",
              node_options:list=[], visibility:list=None, labels:list=[]):
    """A program whose entry point is a compiled TypeScript library.

    Args:
        name: Target name.
        lib: The ts_library to run.
        main: Subpath within the package to start, e.g. "cli.js". Defaults to
              the package's own entry point.
        deps: Further libraries the program imports.
        node_modules: The third-party tree, from npm_link.
        node_options: Flags passed to node.
        visibility: Visibility specification.
        labels: Additional labels.
    """
    return js_binary(
        name = name,
        entry_point = _ts_entry(name, lib, main, False),
        deps = [lib] + deps,
        node_modules = node_modules,
        node_options = node_options,
        visibility = visibility,
        labels = labels,
    )


def ts_test(name:str, lib:str="", main:str="", srcs:list=[], deps:list=[],
            data:list=[], env:dict={}, tsconfig:str="tsconfig.json",
            tsconfig_deps:list=[], root:str="", compiler:str="",
            transpiler:str="", node_modules:str="", node_options:list=[],
            visibility:list=None, labels:list=[], timeout:int=0,
            flaky:bool|int=0, size:str=None):
    """TypeScript tests, under `plz test`.

    Two modes, as js_test has, because a test is one of two things.

    Pass `srcs` and they are a suite: .test.ts files written against node's
    own test runner (node:test, node:assert), compiled and type-checked like a
    ts_library and run by js_test, which reports each test by name. Nothing
    is installed for this. The runner is part of the node runtime, and its
    types come from the NodeTypes config, as the compiler comes from Compiler.

    Pass `lib` and a compiled library runs as a program, passing if it exits
    cleanly: a smoke test of an entry point.

    Args:
        name: Target name.
        lib: The ts_library to run as a program. Exactly one of this and srcs.
        main: With lib, the subpath within the package to start. Defaults to
              the package's own entry point.
        srcs: The suite's sources: its .test.ts files, and any helpers they
              import by relative path. Every *.test file among them is run;
              the rest are only compiled.
        deps: Libraries the tests import by package name -- the ones under
              test -- and, with lib, further libraries the program imports.
        data: Files the tests read rather than import. They stage at their
              package paths, and the working directory is the staging root,
              so a test reads `pkg/fixture.json` by that name.
        env: Environment for the tests.
        tsconfig: The suite's tsconfig, as ts_library takes it.
        tsconfig_deps: The configs it extends.
        root: The prefix stripped from the suite's sources, as ts_library
              takes it.
        compiler: node_modules tree holding the compiler. Defaults to the
                  Compiler config.
        transpiler: What writes the suite's JavaScript, as ts_library takes
                    it. Defaults to the Transpiler config, so a suite is
                    emitted the way the libraries it tests are.
        node_modules: The third-party tree, from npm_link.
        node_options: Flags passed to node.
        visibility: Visibility specification.
        labels: Additional labels.
        timeout: Test timeout in seconds.
        flaky: True to mark the test flaky, or an integer for reruns.
        size: Test size.
    """
    if bool(lib) == bool(srcs):
        fail(f"ts_test {name}: set exactly one of lib or srcs")
    if not srcs:
        return js_test(
            name = name,
            entry_point = _ts_entry(name, lib, main, True),
            deps = [lib] + deps,
            data = data,
            env = env,
            node_modules = node_modules,
            node_options = node_options,
            visibility = visibility,
            labels = labels,
            timeout = timeout,
            flaky = flaky,
            size = size,
        )

    # Compiled exactly as a library is, so a type error in a test fails the
    # build, and handed to js_test as a target: its *.test files are the suite.
    # Named as a package no one imports, one segment so node accepts it.
    suite = ts_library(
        name = f"_{name}_suite",
        srcs = srcs,
        deps = deps,
        package = package_name().replace("/", "-") + "-" + name,
        root = root,
        tsconfig = tsconfig,
        tsconfig_deps = tsconfig_deps,
        compiler = compiler,
        transpiler = transpiler,
        node_modules = node_modules,
        type_roots = [CONFIG.TS.NODE_TYPES] if CONFIG.TS.NODE_TYPES else [],
        test_only = True,
    )
    return js_test(
        name = name,
        srcs = [suite + "|pkg"],
        deps = deps,
        data = data,
        env = env,
        node_modules = node_modules,
        node_options = node_options,
        visibility = visibility,
        labels = labels,
        timeout = timeout,
        flaky = flaky,
        size = size,
    )
