"""TypeScript for Please.

ts_library is a peer of js_library, not a client of it: it emits the same
<name>/pkg + <name>/lib.json shape, so a js_binary consumes it with no change to
js-rules. Declarations sit beside the JavaScript inside pkg/, which is what a
published npm package looks like and what a downstream type-check reads.

The compiler runs from its own node_modules tree, separate from the one holding
the code being compiled. That is not incidental: TypeScript 7 has no stable
programmatic API until 7.1, so typescript-eslint and the Vue, Svelte and Astro
checkers still need a 5.x, and one tree cannot hold two packages claiming the
name "typescript". Keeping the compiler's tree separate means this plugin pins
its own version without that pin reaching into a consumer's lockfile.

Both trees resolve correctly because of how the store is laid out: a package's
dependencies are siblings inside its own store entry, so node resolving from the
compiler's own path finds its native binary without ever walking up to the
consumer's tree, while the consumer's imports resolve upward from the staged
sources. The two walks cannot see each other.
"""

# CONFIG.JS is scoped to files that have loaded the js plugin, and these rules
# defer to its node toolchain, companion tool and node_modules tree rather than
# redeclaring them.
subinclude("///js//build_defs:js")


def ts_library(name:str, srcs:list, deps:list=[], assets:list=[], package:str="",
               entry:str="index.ts", root:str="", tsconfig:str="tsconfig.json",
               tsconfig_deps:list=[],
               module_type:str="", compiler:str="", node_modules:str="",
               source_map:bool=False, declaration_map:bool=False,
               generate_trace:bool=False,
               args:list=[], visibility:list=None,
               test_only:bool&testonly=False, labels:list=[]):
    """A first-party TypeScript library.

    Args:
        name: Target name.
        srcs: Sources for the compiler -- .ts, .tsx and .d.ts, and .js and .jsx
              where the tsconfig sets allowJs.

            A repo does not have to be TypeScript to use this. With allowJs the
            compiler takes JavaScript too, emits declarations for it from its
            JSDoc, and with checkJs type-checks it -- so a repo with five
            hundred .js files and three .ts files points one rule at all of it,
            and one with no TypeScript at all still gets declarations and
            checking.

            There is deliberately no allow_js argument, though rules_ts has one.
            Theirs exists because Bazel has to predict which files are emitted
            before running the compiler, and allowJs changes that set. This rule
            emits a directory, so there is nothing to predict and nothing to
            keep in step with the tsconfig -- one fewer place for the two to
            disagree.
        deps: Other ts_library or js_library targets, and npm_repo targets.
        assets: Files copied into the package verbatim and never shown to the
                compiler. tsc does not copy a .css a component imports, but the
                placed package still needs it there.
        package: The name source code imports this by. Defaults to the package
                 path, as a Go import path mirrors its directory.
        entry: The source the package resolves to. index.ts gives main
               index.js and types index.d.ts.
        root: The prefix stripped from sources, and the compiler's --rootDir.
              Defaults to the package directory.

              Passed explicitly rather than inferred, and that matters: given
              only an output directory the compiler derives the root from the
              common prefix of its inputs, so adding one file at the top of a
              package would shift every emitted path -- and therefore every
              import path in node_modules. It would work for months and then
              break when someone added a file.
        tsconfig: The project's tsconfig.
        tsconfig_deps: The configs it extends, directly or transitively.

                       Listed rather than discovered: `extends` is resolved by
                       the compiler relative to the config naming it, and Please
                       stages sources at their real paths, so naming the chain
                       is all it takes -- nothing is parsed and no path is
                       rewritten. A filegroup cannot do this, because two files
                       both called tsconfig.json would collide on basename.
        module_type: The package.json "type" field. Stated here rather than read
                     out of the tsconfig, so nothing in this plugin parses one.
        source_map: Emit a .js.map beside each emitted file, so a stack trace
                    from this library's output points at the TypeScript it was
                    written as.
        declaration_map: Emit a .d.ts.map beside each declaration. Without it,
                         go-to-definition from a consumer lands in the generated
                         declarations rather than the source -- the difference
                         between navigating a library and reading its ceiling.
        generate_trace: Write the compiler's own performance trace into
                        <name>/trace, beside the package rather than inside it:
                        diagnostics for chrome://tracing, not package content,
                        and only ever wanted at the moment a compile got slow.
        compiler: node_modules tree holding the compiler. Defaults to the
                  Compiler config.

            Naming it per target is how a repo runs two compilers at once, which
            is not an edge case: TypeScript 7 has no stable programmatic API
            until 7.1, so typescript-eslint, ts-jest, ts-morph and the Vue,
            Svelte and Astro checkers all still need a 5.x -- and one
            node_modules cannot hold two packages both called typescript.
            //test/tsc5 compiles and checks against a 5.9 to prove it.
        node_modules: The tree the sources resolve their imports through.
                      Defaults to js-rules' NodeModules config.
        args: Additional compiler flags. The flags this rule's output contract
              depends on -- outDir, rootDir, declaration, noEmit and
              tsBuildInfoFile -- are set here and cannot be overridden.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    package = package or package_name()
    # Same constraint as js_library: the emitted package is imported by name,
    # and node's rules for a name are narrower than a path.
    check_package_name(package, name)
    root = root or package_name()
    compiler = compiler or CONFIG.TS.COMPILER
    node_modules = node_modules or CONFIG.JS.NODE_MODULES

    pkg_dir = package_name()
    strip_len = len(pkg_dir) + 1 if pkg_dir else 0
    dev_srcs = [f[strip_len:] if f.startswith(pkg_dir + "/") else f for f in srcs + assets]

    main = entry.replace(".tsx", ".js").replace(".ts", ".js")
    types = entry.replace(".tsx", ".d.ts").replace(".ts", ".d.ts")
    strip = (root + "/") if root else ""

    # A scratch directory at the staging root, so no `include` glob rooted at
    # the package can reach the compiler's own output.
    out_dir = "_ts_out"

    set_flags = f"--set type={module_type}" if module_type else ""

    return build_rule(
        name = name,
        srcs = {
            "srcs": srcs,
            "assets": assets,
            "config": [tsconfig],
            "extends": tsconfig_deps,
            "modules": [node_modules] if node_modules else [],
            "compiler": [compiler],
        },
        outs = [name],
        cmd = " && ".join([
            'PLEASE_JS=$(readlink -f "$TOOLS_PLEASE_JS")',
            'NODE=$(readlink -f "$TOOLS_NODE")',

            # The compiler's tree and the sources' tree, kept apart.
            'mkdir -p _compiler',
            'cp -R "$SRCS_COMPILER/." _compiler/',
            # Every first-party library staged here describes itself, so the set
            # is collected by shape. node_modules is pruned: without it the walk
            # covers the whole dependency tree twice.
            'LIBS=$(find . -name node_modules -prune -o -name lib.json -print | ' +
            'while read m; do printf -- "--lib %s:%s " "$m" "$(dirname "$m")/pkg"; done)',
            # A repo whose first-party code has no third-party dependencies has
            # no consumer tree at all, and the overlay makes an empty one.
            '"$PLEASE_JS" overlay --tree "${SRCS_MODULES:-}" --out node_modules $LIBS',

            # Run from the staging root: node_modules is then an ancestor of the
            # sources, which is what the compiler's upward resolution needs, and
            # diagnostics come out as pkg/file.ts(3,14) -- the repo path, which
            # an editor can open -- rather than a bare filename.
            f'BIN=$(readlink -f "$("$PLEASE_JS" resolve-bin --tree _compiler --package {CONFIG.TS.COMPILER_PACKAGE} --bin {CONFIG.TS.COMPILER_BIN})")',
            " ".join([
                '"$NODE" "$BIN" -p "$SRCS_CONFIG"',
                f"--rootDir {root} --outDir {out_dir}",
                "--declaration --noEmit false --emitDeclarationOnly false",
                "--tsBuildInfoFile _tsbuildinfo",
            ] + (["--sourceMap"] if source_map else [])
              + (["--declarationMap"] if declaration_map else [])
              + (["--generateTrace _trace"] if generate_trace else [])
              + args),

            # Assemble the shape js_library produces, so a js_binary consumes it
            # without knowing TypeScript was involved.
            'mkdir -p "$OUT/pkg"',
            f'cp -R {out_dir}/. "$OUT/pkg/"',
        ] + ([
            'cp -R _trace "$OUT/trace"',
        ] if generate_trace else []) + [
            f'for a in ${SRCS_ASSETS:-}; do mkdir -p "$OUT/pkg/$(dirname "${{a#{strip}}}")" && cp "$a" "$OUT/pkg/${{a#{strip}}}"; done',
            " ".join([
                '"$PLEASE_JS" describe',
                f"--name {name} --package {package} --version 0.0.0",
                f"--main {main} --types {types}",
                # Where the sources live, for a development server that serves
                # them instead of this compiled output -- it transforms the
                # TypeScript itself, which is why the entry is recorded as
                # written rather than as emitted. Assets are included because a
                # stylesheet a component imports must be servable too.
                f"--src-dir {pkg_dir} --src-entry {entry}",
                " ".join([f"--src {f}" for f in dev_srcs]),
                set_flags,
                '--dir "$OUT/pkg" --out "$OUT/lib.json"',
            ]),
        ]),
        tools = {
            "please_js": [CONFIG.JS.PLEASE_JS_TOOL],
            "node": [CONFIG.JS.NODE_TOOL],
        },
        deps = deps,
        exported_deps = deps,
        needs_transitive_deps = True,
        visibility = visibility,
        test_only = test_only,
        labels = labels + [f"js_library:{package}", f"ts_library:{package}"],
        building_description = "Compiling...",
    )


def ts_check(name:str, srcs:list, deps:list=[], tsconfig:str="tsconfig.json",
             tsconfig_deps:list=[], compiler:str="", node_modules:str="",
             args:list=[], visibility:list=None, test_only:bool&testonly=False,
             labels:list=[]):
    """Type-checks sources without emitting anything.

    ts_library is the wrong shape for an application. An application is not
    imported by name, has no package to be, and its JavaScript is produced by a
    bundler rather than by the compiler -- so a rule that emits a package would
    be emitting something nobody consumes.

    But the checking still has to happen somewhere, and a bundler will not do
    it: esbuild, which is what vite transpiles with, strips types without
    reading them, so a type error in an application reaches production without
    ever failing a build. This is the target that fails it.

    Separate from the bundle on purpose, and not only because the shapes differ.
    They are different failures with different inputs: a type error is not a
    reason to invalidate a bundle's cache, and a changed asset is not a reason
    to type-check again. `tsc && vite build` is the same split, drawn by hand.

    Args:
        name: Target name.
        srcs: Sources to check.
        deps: ts_library and js_library targets the sources import, and npm_repo
              targets. A first-party dependency is checked against its generated
              declarations, which is the whole reason ts_library emits them.
        tsconfig: The tsconfig for this package.
        tsconfig_deps: Every config in the extends chain.
        compiler: node_modules tree holding the compiler. Defaults to the
                  Compiler config.
        node_modules: The tree the sources resolve their imports through.
        args: Additional compiler flags. --noEmit is set here and cannot be
              overridden, since it is the entire point.
        visibility: Visibility specification.
        test_only: If True, only visible to test rules.
        labels: Additional labels.
    """
    compiler = compiler or CONFIG.TS.COMPILER
    node_modules = node_modules or CONFIG.JS.NODE_MODULES

    return build_rule(
        name = name,
        srcs = {
            "srcs": srcs,
            "config": [tsconfig],
            "extends": tsconfig_deps,
            "modules": [node_modules] if node_modules else [],
            "compiler": [compiler],
        },
        # A stamp, because a rule with no output cannot be depended on and would
        # not run. It records what was checked rather than being empty, so a
        # failure to stage a source shows up as a missing name here.
        outs = [name + ".checked"],
        cmd = " && ".join([
            'PLEASE_JS=$(readlink -f "$TOOLS_PLEASE_JS")',
            'NODE=$(readlink -f "$TOOLS_NODE")',
            'mkdir -p _compiler',
            'cp -R "$SRCS_COMPILER/." _compiler/',
            'LIBS=$(find . -name node_modules -prune -o -name lib.json -print | ' +
            'while read m; do printf -- "--lib %s:%s " "$m" "$(dirname "$m")/pkg"; done)',
            '"$PLEASE_JS" overlay --tree "${SRCS_MODULES:-}" --out node_modules $LIBS',
            f'BIN=$(readlink -f "$("$PLEASE_JS" resolve-bin --tree _compiler --package {CONFIG.TS.COMPILER_PACKAGE} --bin {CONFIG.TS.COMPILER_BIN})")',
            " ".join([
                '"$NODE" "$BIN" -p "$SRCS_CONFIG" --noEmit',
                "--tsBuildInfoFile _tsbuildinfo",
            ] + args),
            'for s in $SRCS_SRCS; do echo "$s"; done > "$OUT"',
        ]),
        tools = {
            "please_js": [CONFIG.JS.PLEASE_JS_TOOL],
            "node": [CONFIG.JS.NODE_TOOL],
        },
        deps = deps,
        needs_transitive_deps = True,
        visibility = visibility,
        test_only = test_only,
        labels = labels + ["ts_check"],
        building_description = "Type-checking...",
    )


def _ts_entry(name:str, lib:str, main:str, test_only:bool):
    """Generates the module that starts the program.

    The entry imports the library by its package name rather than by a path into
    the build output, so running a ts_binary exercises the resolution the
    library will actually get from its consumers. A path would work here and
    prove nothing.

    Always ESM, whatever the library emits. Node reads .mjs as a module
    regardless of any package.json, and an ESM entry can import a CommonJS
    package, so one shape serves both -- and neither this rule nor its caller
    has to know or restate the library's module type, which is the sort of
    duplicated declaration that goes stale silently.

    The package name is read out of lib.json with node rather than with sed: the
    file is JSON, node is already a tool here, and a real parser cannot be
    fooled by a package name containing a character that a pattern did not
    anticipate.
    """
    out = f"_{name}_entry.mjs"
    return build_rule(
        name = tag(name, "entry"),
        srcs = {"lib": [lib]},
        outs = [out],
        cmd = " && ".join([
            'NODE=$(readlink -f "$TOOLS_NODE")',
            'LIB=$(readlink -f "$(find "$SRCS_LIB" -name lib.json | head -1)")',
            '"$NODE" -e \'const p=require(process.argv[1]).package;' +
            'const s=process.argv[2];' +
            'process.stdout.write("import "+JSON.stringify(s?p+"/"+s:p)+";\\n")\' ' +
            f'"$LIB" "{main}" > "$OUT"',
        ]),
        tools = {"node": [CONFIG.JS.NODE_TOOL]},
        test_only = test_only,
        building_description = "Generating entry...",
    )


def ts_binary(name:str, lib:str, main:str="", deps:list=[], node_modules:str="",
              node_options:list=[], visibility:list=None, labels:list=[]):
    """A program whose entry point is a compiled TypeScript library.

    Args:
        name: Target name.
        lib: The ts_library to run.
        main: Subpath within the package to start, e.g. "cli.js". Defaults to
              the package's own entry point.
        deps: Further libraries the program imports.
        node_modules: The third-party tree, from npm_link.
        node_options: Flags passed to node.
        visibility: Visibility specification.
        labels: Additional labels.
    """
    return js_binary(
        name = name,
        entry_point = _ts_entry(name, lib, main, False),
        deps = [lib] + deps,
        node_modules = node_modules,
        node_options = node_options,
        visibility = visibility,
        labels = labels,
    )


def ts_test(name:str, lib:str, main:str="", deps:list=[], node_modules:str="",
            node_options:list=[], visibility:list=None, labels:list=[],
            timeout:int=0, flaky:bool|int=0, size:str=None):
    """A compiled TypeScript library run under `plz test`.

    Args:
        name: Target name.
        lib: The ts_library to run.
        main: Subpath within the package to start. Defaults to the package's
              own entry point.
        deps: Further libraries the test imports.
        node_modules: The third-party tree, from npm_link.
        node_options: Flags passed to node.
        visibility: Visibility specification.
        labels: Additional labels.
        timeout: Test timeout in seconds.
        flaky: True to mark the test flaky, or an integer for reruns.
        size: Test size.
    """
    return js_test(
        name = name,
        entry_point = _ts_entry(name, lib, main, True),
        deps = [lib] + deps,
        node_modules = node_modules,
        node_options = node_options,
        visibility = visibility,
        labels = labels,
        timeout = timeout,
        flaky = flaky,
        size = size,
    )
