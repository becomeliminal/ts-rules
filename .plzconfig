[please]
version = >=17.27.0

[PluginDefinition]
Name = ts

[PluginConfig "compiler"]
ConfigKey = Compiler
DefaultValue = ///ts//third_party/js:compiler
Help = node_modules tree holding the TypeScript compiler. Kept separate from the consumer's tree so the plugin pins its own version, and so a second TypeScript can coexist: TS 7 has no stable programmatic API until 7.1, which typescript-eslint and Astro's checker need.
Inherit = true

[PluginConfig "node_types"]
ConfigKey = NodeTypes
DefaultValue = ///ts//third_party/js:node_types
Help = node_modules tree whose @types the compiler loads for a ts_test suite. Its tests run under node's own test runner, so they import node:test and node:assert, and their types come with the runner rather than from the consumer's tree -- the same reason the plugin ships its compiler. Point it at a tree pinning the @types/node that matches your node.
Optional = true
Inherit = true

[PluginConfig "compiler_package"]
ConfigKey = CompilerPackage
DefaultValue = typescript
Help = npm package within the compiler tree that publishes the compiler.
Inherit = true

[PluginConfig "compiler_bin"]
ConfigKey = CompilerBin
DefaultValue = tsc
Help = Executable that package publishes.
Inherit = true

[PluginConfig "transpiler"]
ConfigKey = Transpiler
DefaultValue = tsc
Help = What writes a ts_library's JavaScript. tsc means the compiler, which also type-checks it. esbuild and swc name the transpilers this plugin ships, and a build label names a ts_transpiler target of your own. With anything but tsc the compiler still type-checks every source and writes its declarations, in the same build action, and the transpiler writes the JavaScript -- differently where it matters: both mark an enum as free of side effects, which lets a bundler drop one nobody uses.
Inherit = true

[PluginConfig "esbuild_transpiler"]
ConfigKey = EsbuildTranspiler
DefaultValue = ///ts//tools/transpile:esbuild
Help = The ts_transpiler that transpiler = "esbuild" names. The plugin pins its own esbuild; point this at a ts_transpiler over your own tree to choose the version.
Inherit = true

[PluginConfig "swc_transpiler"]
ConfigKey = SwcTranspiler
DefaultValue = ///ts//tools/transpile:swc
Help = The ts_transpiler that transpiler = "swc" names.
Inherit = true

[PluginConfig "transpile_driver"]
ConfigKey = TranspileDriver
DefaultValue = ///ts//tools/transpile:driver
Help = The program every ts_transpiler runs under: it reads the resolved tsconfig, decides each file's module format and refuses options the transpiler does not implement.
Inherit = true

[Plugin "js"]
Target = //plugins:js
; js-rules' own toolchain target lives in its subrepo and would need the node
; plugin registered there. A consumer supplies its own, which is the honest
; shape: the toolchain belongs to the repo being built.
NodeTool = //third_party/node:node|node
; This plugin's own fixtures have no third-party dependencies, so there is no
; consumer tree to point at. A repo using ts-rules sets this to its own.
NodeModules =

[Plugin "node"]
Target = //plugins:node

[Plugin "go"]
Target = //plugins:go
gotool = ///js//third_party/go:gotool|go

; No [Parse] preloadsubincludes: that config ships to every consumer, so
; anything preloaded here becomes a requirement on any repo that parses a
; package of this plugin. rust-rules documents avoiding it for the same reason.
